<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= content_for?(:title) ? "#{yield(:title)} - Pokemon TCG" : 'Pokemon TCG' %></title>
    <meta name="description" content="Browse Pokemon trading cards, build a rules-checked 60 card deck and learn how the game is played. A Ruby on Rails portfolio project.">
    <link rel="icon" type="image/ico" href="/pokeball_icon.ico">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <%# Fonts load without blocking the first paint (system fonts show until they arrive). One variable file per family. %>
    <% fonts_url = 'https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Nunito+Sans:wght@400..800&display=swap' %>
    <link rel="stylesheet" href="<%= fonts_url %>" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="<%= fonts_url %>"></noscript>
    <%# Bootstrap first, so the app stylesheet can override it %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <%= render 'layouts/rails_default' %>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <%= render 'layouts/nav' %>
    <main id="main" class="page">
      <div class="container">
        <%= render 'shared/flash_messages' %>
        <%= yield %>
      </div>
    </main>
    <%= render 'layouts/footer' %>
  </body>
</html>
