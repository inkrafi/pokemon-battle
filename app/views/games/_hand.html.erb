<%# The viewer's hand. Each card offers the moves the rules allow for it right now. %>
<section class="hand" data-fx-my-hand aria-labelledby="hand-heading">
  <h2 id="hand-heading">Your hand <small>(<%= board.hand.size %>)</small></h2>

  <% if board.hand.empty? && !board.drawing? %>
    <p class="text-slate">Your hand is empty.</p>
  <% else %>
    <ul class="hand__cards">
      <% if board.drawing? %>
        <li class="hand-card hand-card--deck">
          <%= game_action_with board, { type: 'draw' }, class: 'deck-pile', aria: { label: 'Draw a card' } do %>
            <%# the two halves of the deck that riffle into each other before the draw (src/game_fx.js) %>
            <span class="deck-pile__half deck-pile__half--left" aria-hidden="true"></span>
            <span class="deck-pile__half deck-pile__half--right" aria-hidden="true"></span>
            <span class="deck-pile__count"><%= board.deck_count(board.viewer) %></span>
          <% end %>
          <%= game_action board, 'Draw a card', { type: 'draw' }, class: 'btn btn-primary btn-sm' %>
        </li>
      <% end %>
      <% drawn = board.drawn_uid %>
      <% board.hand.each do |entry| %>
        <% card = entry.card %>
        <% just_drawn = entry.uid == drawn %>
        <li class="hand-card<%= ' is-new' if just_drawn %>" data-fx-card="<%= entry.uid %>" data-type="<%= (card.type || 'Colorless').parameterize %>"<% if just_drawn %> data-just-drawn="game-<%= board.game.id %>-turn-<%= board.turn_number %>"<% end %>>
          <% if just_drawn %><span class="hand-card__new">New</span><% end %>
          <%= card_thumb(card) %>

          <div class="hand-card__actions">
            <% if card.basic_pokemon? && board.can_bench?(entry.uid) %>
              <%= game_action board, 'Put on Bench', { type: 'bench', card: entry.uid }, class: 'btn btn-outline-dark btn-sm' %>
            <% end %>
            <% board.evolve_targets(entry.uid).each do |target, label| %>
              <%= game_action board, "Evolve #{label}", { type: 'evolve', card: entry.uid, target: target }, class: 'btn btn-outline-dark btn-sm' %>
            <% end %>
            <% board.attach_targets(entry.uid).each do |target, label| %>
              <%= game_action board, "Attach to #{label}", { type: 'attach', card: entry.uid, target: target }, class: 'btn btn-outline-dark btn-sm' %>
            <% end %>
            <% if card.trainer? && (fields = board.play_fields(entry.uid)) %>
              <%= render 'games/choice_form', board: board, label: 'Play', move: { type: 'play', card: entry.uid }, fields: fields %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
